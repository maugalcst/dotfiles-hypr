autogenerated = 0
$mainMod = SUPER
$terminal = kitty

input {
    kb_layout = latam
    follow_mouse = 1
    touchpad {
        natural_scroll = true
    }
}

general {
    border_size = 1
    col.active_border = rgba(c8beb4cc)
    col.inactive_border = rgba(2a2825ff)
    gaps_in = 5
    gaps_out = 10
}

decoration {
    rounding = 2
    active_opacity = 1.0
    inactive_opacity = 0.85
    shadow {
        enabled = false
    }
}

animations {
    enabled = true

    bezier = smooth, 0.25, 1.0, 0.5, 1.0

    animation = windows, 1, 4, smooth, popin 80%
    animation = windowsOut, 1, 3, smooth, popin 80%
    animation = windowsMove, 1, 3, smooth
    animation = fade, 1, 4, smooth
    animation = workspaces, 1, 4, smooth, slidefade 20%
}

# Workspaces
workspace = 1, name:hermes, monitor:HDMI-A-1, persistent:true
workspace = 2, name:atlas, monitor:HDMI-A-1, persistent:true
workspace = 3, name:nyx, monitor:HDMI-A-1, persistent:true
workspace = 4, name:aion, monitor:HDMI-A-1, persistent:true
workspace = 5, name:nous, monitor:eDP-1, persistent:true

# Autostart
exec-once = waybar
exec-once = awww-daemon
exec-once = awww img /home/mau/Descargas/camille-7fxH78ed_Cc-unsplash.jpg
exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = hyprctl keyword input:kb_layout latam
exec-once = dunst -config ~/.config/dunst/dunstrc
exec-once = wl-paste --type text --watch cliphist store
exec-once = wl-paste --type image --watch cliphist store
exec-once = swayosd-server

# Apps
bind = $mainMod, RETURN, exec, $terminal
bind = $mainMod, Q, killactive
bind = $mainMod, M, exit
bind = $mainMod, E, exec, dolphin
bind = $mainMod, R, exec, rofi -show drun
bind = $mainMod, F, fullscreen
bind = $mainMod, V, togglefloating

# Navegación entre ventanas
bind = $mainMod, left, movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up, movefocus, u
bind = $mainMod, down, movefocus, d

# Mover ventanas
bind = $mainMod SHIFT, left, movewindow, l
bind = $mainMod SHIFT, right, movewindow, r
bind = $mainMod SHIFT, up, movewindow, u
bind = $mainMod SHIFT, down, movewindow, d

# Redimensionar ventanas
binde = $mainMod CTRL, right, resizeactive, 30 0
binde = $mainMod CTRL, left, resizeactive, -30 0
binde = $mainMod CTRL, up, resizeactive, 0 -30
binde = $mainMod CTRL, down, resizeactive, 0 30

# Workspaces
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4

# Navegar workspaces con Alt
bind = $mainMod ALT, left, workspace, e-1
bind = $mainMod ALT, right, workspace, e+1

# Scratchpad
bind = $mainMod, S, togglespecialworkspace, magic

# Mouse
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow

# Screenshot
bind = $mainMod SHIFT, S, exec, grimblast copy area

# Brillo
bind = , XF86MonBrightnessUp, exec, swayosd-client --brightness raise
bind = , XF86MonBrightnessDown, exec, swayosd-client --brightness lower

# Volumen
bind = , XF86AudioRaiseVolume, exec, swayosd-client --output-volume raise
bind = , XF86AudioLowerVolume, exec, swayosd-client --output-volume lower
bind = , XF86AudioMute, exec, swayosd-client --output-volume mute-toggle

# Reload
bind = $mainMod SHIFT, R, exec, hyprctl reload

# Región
bind = , Print, exec, hyprshot -m region -o ~/capturas

# Pantalla completa
bind = SHIFT, Print, exec, hyprshot -m output -o ~/capturas

# Ventana activa
bind = CTRL, Print, exec, hyprshot -m window -o ~/capturas

# Copia al portapapeles
bind = ALT, Print, exec, hyprshot -m region --clipboard-only

# Wlogout
bind = SUPER, ESCAPE, exec, wlogout --protocol layer-shell

# Hyprlock
bind = SUPER, L, exec, hyprlock

# CLiphist
bind = $mainMod, Space, exec, cliphist list | rofi -dmenu | cliphist decode | wl-copy

# "Maximizar" (ocupa la pantalla pero respeta tu barra y los gaps)
bind = $mainMod SHIFT, F, fullscreen, 1

env = XCURSOR_THEME,Bibata-Modern-Classic
env = XCURSOR_SIZE,24
env = GSETTINGS_SCHEMA_DIR,/usr/share/glib-2.0/schemas
env = QT_QPA_PLATFORMTHEME,qt6ct

# Variables para que las apps sepan que están en Hyprland
env = XDG_CURRENT_DESKTOP,Hyprland
env = XDG_SESSION_TYPE,wayland
env = XDG_SESSION_DESKTOP,Hyprland

# Para que VS Code y Electron se porten bien en Wayland
env = ELECTRON_OZONE_PLATFORM_HINT,auto

# Sincronización de DBus al inicio
exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
